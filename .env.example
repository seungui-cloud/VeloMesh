# ── 앱(Expo)에서 읽는 값 ──────────────────────────────
# 토큰 서버 주소. 개발 시 이 PC의 LAN IP (휴대폰이 같은 Wi-Fi에 있어야 함)
EXPO_PUBLIC_TOKEN_ENDPOINT=http://192.168.0.10:8787
# LiveKit 서버 URL (토큰 서버 응답에도 포함되므로 생략 가능)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── 토큰 서버(server/token-server.mjs)에서 읽는 값 ─────
# https://cloud.livekit.io → 프로젝트 생성 → Settings > Keys 에서 발급
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── MVP v0.2 (Supabase: Club/Ride/Pack/인증) ──────────
# https://supabase.com → 프로젝트 생성 후 설정
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
